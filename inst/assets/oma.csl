<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never">
  <info>
    <title>OMA compact author-date</title>
    <id>https://microbiome.github.io/OMA/oma-compact</id>
    <summary>Compact author-date style for the OMA book. Bibliography entries
      start with the title, give the first author's surname and the year
      (Surname et al. (2005)), abbreviate journal names and show DOIs as
      doi:.</summary>
    <category citation-format="author-date"/>
    <category field="biology"/>
    <updated>2026-11-18T00:00:00+00:00</updated>
    <rights license="https://creativecommons.org/licenses/by-sa/4.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 4.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="et-al">et al.</term>
    </terms>
  </locale>

  <!-- First author only, surname followed by initials without periods -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" delimiter=", " et-al-min="2" et-al-use-first="1"/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-citation">
    <names variable="author">
      <name form="short" and="text" delimiter=", " et-al-min="3" et-al-use-first="1"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title" form="short" font-style="italic"/>
      </substitute>
    </names>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="source">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=" ">
          <text variable="container-title" form="short" font-style="italic"/>
          <group delimiter=":">
            <text variable="volume"/>
            <text variable="page"/>
          </group>
        </group>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <group delimiter=" ">
          <text term="in" text-case="capitalize-first"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </else-if>
      <else-if type="book thesis report" match="any">
        <group delimiter=". ">
          <text variable="collection-title"/>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else>
        <group delimiter=". ">
          <text variable="container-title" form="short" font-style="italic"/>
          <text variable="publisher"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="note">
    <choose>
      <if type="article-journal chapter paper-conference" match="none">
        <text variable="note"/>
      </if>
    </choose>
  </macro>
  <macro name="locator">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi:"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="true" collapse="year">
    <sort>
      <key macro="year"/>
      <key macro="author-citation"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author-citation"/>
          <text macro="year"/>
        </group>
        <group>
          <label variable="locator" form="short" suffix=" "/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="false" entry-spacing="0" et-al-min="2" et-al-use-first="1">
    <sort>
      <key macro="author-short"/>
      <key macro="year"/>
      <key variable="title"/>
    </sort>
    <layout>
      <group delimiter=". " suffix=".">
        <text variable="title"/>
        <group delimiter=" ">
          <text macro="author-short"/>
          <group prefix="(" suffix=")">
            <text macro="year"/>
          </group>
        </group>
        <text macro="source"/>
        <text macro="note"/>
        <text macro="locator"/>
      </group>
    </layout>
  </bibliography>
</style>
